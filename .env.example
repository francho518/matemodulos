# Copia este archivo como .env.local y completa los valores.
# Los encuentras en Supabase > Project Settings > API.

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anonima-publica

# Opcional: URL pública del sitio. Se usa para los enlaces de confirmación
# de correo cuando no se puede detectar desde la petición.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
